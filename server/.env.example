# Supabase Postgres — ambil dari Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase project. BELUM dibaca kode mana pun — disiapkan untuk verifikasi
# JWT Supabase Auth (task "Daftar & Masuk Akun", Fase 4) dan Storage bukti
# jemput. Boleh dikosongkan sampai saat itu; server tidak akan mencarinya.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

PORT=3001

# Membuka identitas lewat header `x-user-id` (pengembangan lokal saja).
# JANGAN pernah disetel di produksi: siapa pun yang tahu satu id warga bisa
# mengaku jadi warga itu. Dicabut saat verifikasi JWT Supabase Auth masuk
# (task "Daftar & Masuk Akun", Fase 4).
AUTH_DEV_HEADER=1

# Midtrans Core API — Settings → Access Keys di dashboard Midtrans.
# Pakai Sandbox Server Key selama pengembangan.
MIDTRANS_SERVER_KEY=

# 1 = tagih ke Midtrans produksi (uang sungguhan). Kosong/0 = sandbox.
MIDTRANS_PRODUKSI=
